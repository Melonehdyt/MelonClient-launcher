{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MelonClientLauncher",
  "version": "0.1.0",
  "identifier": "dev.melon.melonclient.launcher",
  "build": {
    "beforeDevCommand": "npm run serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Melon Client Launcher",
        "width": 1040,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
